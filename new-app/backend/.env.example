# Backend .env — copy to .env and fill values

APP_NAME="StockOpname API"
DEBUG=true
PORT=8000

# JWT
SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://stockopname:secret@localhost:5432/stockopname

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_ALL=false

# Storage — gunakan path ABSOLUT di production (contoh: /var/www/backend/storage)
# Jika tidak diset, default ke <project-root>/storage (relatif ke src/)
STORAGE_PATH=

# ── Notifikasi ────────────────────────────────────────────────────────────────
# Dua channel dikirim BERSAMAAN: user yang punya telegram_chat_id dan email
# menerima keduanya. Fonnte & Evolution sudah dihapus sepenuhnya.

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org

# Email (SMTP). Gmail: host smtp.gmail.com, port 465, user = alamat pengirim,
# password = App Password 16 karakter (butuh 2FA aktif di akun Google).
# Host/port/user juga bisa diubah lewat Admin → Pengaturan → Email;
# PASSWORD hanya dari sini, tidak pernah disimpan di database.
# Kuota Gmail: 500 penerima/hari (@gmail.com) atau 2.000/hari (Workspace).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Meta Ads
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_API_VERSION=v21.0

# App URLs
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3001

# MediaMTX (CCTV live streaming)
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_HLS_BASE_URL=http://localhost:8888
MEDIAMTX_WEBRTC_BASE_URL=http://localhost:8889
