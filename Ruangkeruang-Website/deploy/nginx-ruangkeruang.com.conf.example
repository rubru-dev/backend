server {
    listen 80;
    listen [::]:80;
    server_name ruangkeruang.com www.ruangkeruang.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://ruangkeruang.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.ruangkeruang.com;

    ssl_certificate /etc/letsencrypt/live/ruangkeruang.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ruangkeruang.com/privkey.pem;

    return 301 https://ruangkeruang.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ruangkeruang.com;

    ssl_certificate /etc/letsencrypt/live/ruangkeruang.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ruangkeruang.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
