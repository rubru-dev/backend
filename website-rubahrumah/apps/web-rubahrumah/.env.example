# API backend (new-app/backend)
# Production public routes: https://rubru.id/v1/public/rb/*
NEXT_PUBLIC_API_URL=https://rubru.id/v1
NEXT_PUBLIC_STORAGE_URL=https://rubru.id

# Domain utama situs (canonical, sitemap, robots.txt, OG image).
# Situs dilayani dari rubahrumah.com DAN main.rubru.id — nilai ini menentukan
# mana yang dianggap utama oleh Google. Dibaca saat BUILD, jadi wajib rebuild
# kalau diubah. Tanpa trailing slash.
NEXT_PUBLIC_SITE_URL=https://rubahrumah.com
